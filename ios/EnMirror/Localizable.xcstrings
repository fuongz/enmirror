{
  "sourceLanguage": "en",
  "strings": {
    "A clear mirror with a ring light. Free, with no ads.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gương soi rõ nét, có đèn viền. Miễn phí, không quảng cáo."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới thiệu"
          }
        }
      }
    },
    "About enMirror": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới thiệu enMirror"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi công"
          }
        }
      }
    },
    "Allow Photos access in Settings to save": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép truy cập Ảnh trong Cài đặt để lưu"
          }
        }
      }
    },
    "Allow camera access for enMirror in Settings to use the mirror.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép enMirror dùng camera trong Cài đặt để soi gương."
          }
        }
      }
    },
    "App icon: original artwork made for enMirror.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon app: hình vẽ riêng cho enMirror."
          }
        }
      }
    },
    "As others see you": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Như người khác nhìn bạn"
          }
        }
      }
    },
    "Camera access is off": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có quyền dùng camera"
          }
        }
      }
    },
    "Captures a still so you can look closely": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp lại khung hình để bạn xem kỹ"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép"
          }
        }
      }
    },
    "Copies the version for a support request": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép phiên bản để gửi khi cần hỗ trợ"
          }
        }
      }
    },
    "Costs nothing, now or later.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tốn đồng nào, bây giờ hay sau này."
          }
        }
      }
    },
    "Couldn't capture a photo": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chụp được ảnh"
