    "Opens Settings › enMirror › Language. enMirror restarts in the language you pick.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt › enMirror › Ngôn ngữ. enMirror sẽ mở lại bằng ngôn ngữ bạn chọn."
          }
        }
      }
    },
    "Opens enMirror to the live mirror with the ring light on.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở enMirror vào thẳng gương, bật sẵn đèn viền."
          }
        }
      }
    },
    "Opens enMirror to the live mirror.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở enMirror vào thẳng gương."
          }
        }
      }
    },
