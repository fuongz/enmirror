      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ghim. Chạm vào ảnh để xem kỹ."
          }
        }
      }
    },
    "Privacy Policy": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính sách quyền riêng tư"
