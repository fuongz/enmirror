      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ ghim ảnh"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản"
