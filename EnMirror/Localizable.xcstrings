{
  "sourceLanguage": "en",
  "strings": {
    "Allow Photos access in Settings to save": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép truy cập Ảnh trong Cài đặt để lưu"
          }
        }
      }
    },
    "Allow camera access for enMirror in Settings to use the mirror.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép enMirror dùng camera trong Cài đặt để soi gương."
          }
        }
      }
    },
    "As others see you": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Như người khác nhìn bạn"
          }
        }
      }
    },
    "Camera access is off": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có quyền dùng camera"
