{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Static site for enmirror.trinhvaphuong.com: landing, privacy policy, terms, support and brand,
	// in Vietnamese (/) and English (/en). App Store Connect and the iOS app (AppLinks.swift) link
	// to /privacy and /support. Assets only, no Worker script. `bun run build` prerenders every
	// page to dist/<path>.html; Workers serves /privacy from privacy.html.
	"name": "enmirror-landing-production",
	"account_id": "4db494888d9a82bbe3df140e2e1a7676",
	"compatibility_date": "2026-10-03",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "enmirror.trinhvaphuong.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
