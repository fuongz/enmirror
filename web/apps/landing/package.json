{
	"name": "@enmirror/landing",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"cf-typegen": "wrangler types",
		"dev": "vite",
		"build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && bun scripts/prerender.ts",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"preview": "bun run build && wrangler dev",
		"deploy": "ENMIRROR_RELEASE=1 bun run build && wrangler deploy"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/newsreader": "5.3.0",
		"@hugeicons/core-free-icons": "4.4.0",
		"@hugeicons/react": "1.1.10",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.0",
		"lucide-react": "1.61.0",
		"motion": "14.5.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"shadcn": "4.23.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"vite": "8.3.5",
		"wrangler": "4.156.1"
	}
}
